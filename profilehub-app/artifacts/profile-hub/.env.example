# ============================================================================
# ProfileHub - Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================================

# Supabase public browser/client config.
# Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY. NEXT_PUBLIC_SUPABASE_ANON_KEY is
# supported as a fallback for older deployments. These are never used for admin
# database operations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase server-only admin config. Never prefix these keys with NEXT_PUBLIC_.
#
# Set exactly ONE of these. supabase-admin-env.ts reads them in the order below
# and uses the FIRST one present, so a bad value in SUPABASE_SECRET_KEY silently
# shadows a working SUPABASE_SERVICE_ROLE_KEY.
#
# WARNING: the new-style sb_secret_ key is not enabled on every project. On
# project kjwdeufxrhcckwvsekcd it is rejected with "Invalid API key" even though
# the matching sb_publishable_ key works. The code only validates the key's
# PREFIX, not that Supabase accepts it, so an unusable key passes startup checks
# and fails at request time. Verify with `npm run check:supabase` after changing
# either value.
#
# SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=service_role_jwt

# Application
APP_URL=http://localhost:24359
NEXT_PUBLIC_APP_URL=http://localhost:24359

# AI Provider
AI_PROVIDER=openrouter
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated fallback chain, tried in order. Free models are retired and
# rate-limited often - verify a chain still works before relying on it:
#   curl https://openrouter.ai/api/v1/models -H "Authorization: Bearer $OPENROUTER_API_KEY"
OPENROUTER_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Optional legacy fallback if OPENROUTER_MODELS is not set.
OPENROUTER_MODEL=
# Set to true in preview/staging if you want provider errors returned instead of mock fallback.
AI_EXPOSE_PROVIDER_ERRORS=false

# Logging
# debug | info | warn | error
LOG_LEVEL=info

# Security
# Used to hash visitor IPs in analytics. Optional, but recommended.
LOG_HASH_SALT=your-random-hash-salt
